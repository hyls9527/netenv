                                    "source":  "MetaCubeX/mihomo",
                                    "filename":  "mihomo-windows-amd64.exe",
                                    "minBytes":  40000000
                                },
                     "newApi":  {
                                    "source":  "QuantumNous/new-api",
                                    "filename":  "new-api.exe",
                                    "minBytes":  100000000
                                },
                     "subStore":  {
                                      "source":  "sub-store-org/Sub-Store",
                                      "filename":  "sub-store.exe",
                                      "assetPattern":  "",
                                      "minBytes":  1000000
                                  }
                 },
