                             "*.msftncsi.com",
                             "*.outlook.com",
                             "*.psbc.com",
                             "*.qq.com/mail",
                             "*.windows.com",
                             "*.windows.net",
                             "*.windowsupdate.com",
                             "*.xbox.com",
                             "*.xboxlive.com",
                             "163.com",
                             "abchina.com",
                             "bankofchina.com",
                             "ccb.com",
                             "cmbchina.com",
