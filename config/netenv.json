                         "run-ow-guardian.vbs",
                         "run-voice-guardian.vbs",
                         "run-permafrost-guardian.vbs",
                         "run-free-refresh.vbs",
                         "start-ai-stack-hidden.vbs"
                     ],
    "oldProcesses":  [
                         "mihomo-windows-amd64",
                         "gemini-web2api-go",
                         "token-free-gateway-windows-x64",
