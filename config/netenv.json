                    "archiveDir":  "backups\\secrets",
                    "archivePrefix":  "netenv-secrets"
                },
    "optionalServices":  [
                             "subStore",
                             "newApi"
                         ],
    "guardianTasks":  [
                          "AI-Stack-Guardian",
                          "OW-Proxy-Guardian",
                          "OW-Proxy-Startup",
                          "FreeProxy-Refresh",
                          "Permafrost-Guardian",
                          "Permafrost-Guardian-Logon",
