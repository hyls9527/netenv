                                  "api.github.com",
                                  "codeload.github.com",
                                  "github.com",
                                  "objects.githubusercontent.com",
                                  "raw.githubusercontent.com",
                                  "ssh.github.com"
                              ],
    "subscription":  {
                         "urlTest":  {
                                         "url":  "https://www.google.com/generate_204",
                                         "interval":  300,
                                         "tolerance":  50,
                                         "lazy":  true
                                     },
                         "githubUrlTest":  {
                                               "url":  "https://github.com/robots.txt",
                                               "interval":  60,
                                               "tolerance":  50,
                                               "lazy":  true
                                           }
                     },
    "noProxy":  [
                    "*.cn",
                    "*.microsoft.com",
                    "*.microsoftonline.com",
                    "*.microsoftazuread-sso.com",
                    "*.microsoftonline-p.com",
                    "*.microsoftonline-p.net",
