    "profiles":  {
                     "direct":  {
                                    "systemProxy":  false,
                                    "gitProxy":  "",
                                    "envProxy":  false,
                                    "npmProxy":  ""
                                },
                     "proxy":  {
                                   "systemProxy":  true,
                                   "gitProxy":  "http://127.0.0.1:7897",
                                   "envProxy":  true,
                                   "npmProxy":  "http://127.0.0.1:7897"
                               },
