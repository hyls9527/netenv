{
    "mode":  "portable",
    "ports":  {
                  "mihomoMixed":  7890,
                  "mihomoHttp":  7897,
                  "mihomoController":  19090,
                  "newApi":  8093,
                  "subStore":  3001
              },
    "logging":  {
                    "rotateDays":  14,
                    "dir":  "logs"
                },
    "supervisor":  {
                       "maxRestartPerRound":  2,
                       "maxFailingRounds":  6,
                       "intervalMinutes":  1
                   },
    "health":  {
                   "probeUrl":  "https://www.google.com/generate_204",
                   "probeUrls":  [
                                     "https://www.google.com/generate_204",
                                     "https://github.com/robots.txt"
                                 ],
                   "probeIntervalMinutes":  5,
                   "failThreshold":  2,
                   "autoRefreshOnFail":  true,
                   "autoRefreshMinIntervalMinutes":  30,
                   "autoFallbackToDirect":  false,
                   "githubProbe":  {
                                       "enabled":  true,
                                       "probeUrls":  [
                                                         "https://github.com/robots.txt"
                                                     ],
                                       "failThreshold":  2,
                                       "group":  "github-adaptive",
                                       "recoverMinIntervalMinutes":  10
                                   }
               },
    "sensitiveDomains":  [
